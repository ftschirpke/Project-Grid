[gd_resource type="Resource" script_class="TileDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/core/tiles/tile_def.gd" id="1"]
[ext_resource type="Script" path="res://src/core/tiles/tile_effect.gd" id="2"]
[ext_resource type="Script" path="res://src/core/tiles/effects/tile_pickup_effect.gd" id="3"]
[ext_resource type="Script" path="res://src/core/choices/choice_option.gd" id="4"]
[ext_resource type="Script" path="res://src/core/choices/upgrade_ability_option.gd" id="5"]

[sub_resource type="Resource" id="throw_damage"]
script = ExtResource("5")
label = "Spear Throw: +1 damage"
description = "Spear Throw deals 1 more damage."
ability_id = &"spear_throw"
effect_kind = &"damage"
property = &"amount"
delta = 1

[sub_resource type="Resource" id="thrust_damage"]
script = ExtResource("5")
label = "Spear Thrust: +1 damage"
description = "Spear Thrust deals 1 more damage."
ability_id = &"spear_thrust"
effect_kind = &"damage"
property = &"amount"
delta = 1

[sub_resource type="Resource" id="pickup"]
script = ExtResource("3")
title = "Upgrade an ability"
options = Array[ExtResource("4")]([SubResource("throw_damage"), SubResource("thrust_damage")])
offer_count = 3
shuffle = false
becomes_symbol = "."

[resource]
script = ExtResource("1")
id = &"upgrade"
display_name = "Upgrade"
symbol = "U"
color = Color(0.78, 1, 0.6, 1)
label = "UP"
on_enter = Array[ExtResource("2")]([SubResource("pickup")])
